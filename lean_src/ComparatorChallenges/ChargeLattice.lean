the dark energy is zero. -/
theorem kaloper_terminates (X θ : ℝ) (N : ℤ) (hN : N ≤ 1) :
    kaloperV X θ (N + ((1 - N).toNat : ℤ)) = 0 := by
  sorry
end Flux

