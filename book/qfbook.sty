% qfbook.sty -- house style of "Quantum Fluids in Lean 4": a tribute to Henri Godfrin.  Compile with LuaLaTeX.
\NeedsTeXFormat{LaTeX2e}\ProvidesPackage{qfbook}[2026/10/09 book style]
\RequirePackage{iftex}\RequireLuaTeX
\RequirePackage{geometry}
\geometry{paperwidth=7.5in,paperheight=10in,inner=1.05in,outer=0.85in,top=0.95in,bottom=1.0in,headheight=14pt,footskip=0.45in}
\RequirePackage{fontspec}
\setmainfont{EB Garamond}[Numbers=OldStyle,Ligatures=TeX]
\setmonofont{DejaVu Sans Mono}[Scale=0.80]
\RequirePackage{unicode-math}
\setmathfont{TeX Gyre Pagella Math}
\RequirePackage{microtype,xcolor,graphicx,booktabs,amsmath,amsthm,enumitem,caption,subcaption,siunitx,setspace,etoolbox,tabularx}
\RequirePackage[most]{tcolorbox}
\RequirePackage{listings}
\RequirePackage{fancyhdr,titlesec,tocloft,epigraph,lettrine}
\RequirePackage[numbers,sort&compress]{natbib}
\RequirePackage[colorlinks=true,linkcolor=qfblue,citecolor=qfblue,urlcolor=qfblue]{hyperref}
\RequirePackage[capitalise,noabbrev]{cleveref}
\setstretch{1.07}
% ---- palette (shared with figstyle.py) ----
\definecolor{qfblue}{HTML}{1F4E79}\definecolor{qfteal}{HTML}{2A7F7F}\definecolor{qforange}{HTML}{C8731A}
\definecolor{qfred}{HTML}{A23B2A}\definecolor{qfgrey}{HTML}{5A5A5A}\definecolor{qfpaper}{HTML}{FAF7F0}\definecolor{qfgold}{HTML}{B8902F}
% ---- headings ----
\titleformat{\chapter}[display]{\normalfont\bfseries\color{qfblue}}{\filleft\scshape\Large\color{qfgrey}Chapter \thechapter}{0.6ex}{\filleft\fontsize{28}{32}\selectfont}[\vspace{1ex}{\color{qfgold}\titlerule[1.2pt]}]
\titlespacing*{\chapter}{0pt}{-10pt}{34pt}
\titleformat{\section}{\normalfont\Large\bfseries\color{qfblue}}{\thesection}{0.7em}{}
\titleformat{\subsection}{\normalfont\large\bfseries\itshape\color{qfteal}}{\thesubsection}{0.7em}{}
\pagestyle{fancy}\fancyhf{}\fancyhead[LE]{\small\scshape\leftmark}\fancyhead[RO]{\small\itshape\rightmark}\fancyfoot[C]{\small\thepage}
\renewcommand{\headrulewidth}{0.3pt}\renewcommand{\chaptermark}[1]{\markboth{\thechapter.\ #1}{}}\renewcommand{\sectionmark}[1]{\markright{#1}}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\small\thepage}\renewcommand{\headrulewidth}{0pt}}
% ---- theorem-like ----
\theoremstyle{plain}\newtheorem{theorem}{Theorem}[chapter]\newtheorem{proposition}[theorem]{Proposition}\newtheorem{lemma}[theorem]{Lemma}
\theoremstyle{definition}\newtheorem{definition}[theorem]{Definition}\theoremstyle{remark}\newtheorem{remark}[theorem]{Remark}
% ---- Lean listings ----
\lstdefinelanguage{Lean}{morekeywords={theorem,lemma,def,noncomputable,namespace,end,open,import,by,fun,have,show,from,at,with,where,structure,instance,variable,example,calc,intro,exact,rw,simp,linarith,nlinarith,positivity,field_simp,ring,norm_num,unfold,obtain,rcases,refine,use,constructor,cases,induction,apply,rfl,Type,Prop,theorem},
  sensitive=true,morecomment=[l]{--},morecomment=[s]{/-}{-/},morestring=[b]",}
\lstdefinestyle{lean}{language=Lean,basicstyle=\ttfamily\small,keywordstyle=\color{qfblue}\bfseries,commentstyle=\color{qfgrey}\itshape,stringstyle=\color{qfred},
  showstringspaces=false,columns=fullflexible,keepspaces=true,breaklines=true,breakatwhitespace=false,postbreak=\mbox{\textcolor{qfgold}{$\hookrightarrow$}\space},xleftmargin=0.6em,xrightmargin=0.3em,aboveskip=0pt,belowskip=0pt}
\lstdefinestyle{plainmono}{basicstyle=\ttfamily\small,columns=fullflexible,keepspaces=true,breaklines=true,showstringspaces=false}
\lstdefinelanguage{RustLite}{morekeywords={fn,let,mut,pub,struct,impl,for,in,use,mod,match,if,else,return,self,Self,const,loop,while,as},sensitive=true,morecomment=[l]{//},morestring=[b]"}
\lstdefinestyle{rust}{language=RustLite,basicstyle=\ttfamily\small,keywordstyle=\color{qforange}\bfseries,commentstyle=\color{qfgrey}\itshape,columns=fullflexible,keepspaces=true,breaklines=true,showstringspaces=false}
\lstdefinestyle{py}{language=Python,basicstyle=\ttfamily\small,keywordstyle=\color{qfteal}\bfseries,commentstyle=\color{qfgrey}\itshape,stringstyle=\color{qfred},columns=fullflexible,keepspaces=true,breaklines=true,showstringspaces=false}
% ---- boxes ----
\tcbset{qfbase/.style={enhanced,breakable,boxrule=0.5pt,arc=2pt,left=7pt,right=7pt,top=5pt,bottom=5pt,fonttitle=\bfseries\scshape,before skip=10pt plus 2pt,after skip=10pt plus 2pt}}
\newtcolorbox{leanbox}[2][]{qfbase,colback=qfblue!4,colframe=qfblue,title={Lean 4 \enspace #2},#1}                  % a machine-checked statement (use lstlisting[style=lean] inside)
\newtcolorbox{rustbox}[2][]{qfbase,colback=qforange!5,colframe=qforange,title={rusty-SUNDIALS \enspace #2},#1}       % a solver computation
\newtcolorbox{godfrinbox}[2][]{qfbase,colback=qfgold!10,colframe=qfgold,title={Godfrin \enspace #2},#1}             % what Godfrin measured
\newtcolorbox{honestbox}[1][What this establishes, and what it does not]{qfbase,colback=qfred!4,colframe=qfred,title={#1}}
\newtcolorbox{keybox}[1][Key idea]{qfbase,colback=qfteal!5,colframe=qfteal,title={#1}}
\newcommand{\lean}[1]{\texttt{#1}}
\newcommand{\Lthm}[2]{\texttt{QuantumFluids.#1.#2}}                    % \Lthm{ZeroSound}{zero_sound_2d_iff}
\newcommand{\hbark}{\hbar}\newcommand{\dd}{\mathrm{d}}\newcommand{\ii}{\mathrm{i}}\newcommand{\ee}{\mathrm{e}}
\captionsetup{font=small,labelfont={bf,color=qfblue},format=hang}
\newcommand{\figwidth}{\linewidth}
\setlength{\parindent}{1.2em}\setlength{\parskip}{0pt}
\setlist{nosep,leftmargin=1.4em}
\setlength{\emergencystretch}{1.5em}% long monospace Lean names in running text otherwise leave overfull lines
% ---- book-wide fixes (editor, 2026-10-09) ----
% (1) LuaLaTeX + listings 1.9: characters above U+00FF in a listing are typeset AHEAD of the buffered ASCII text
%     ("(pi / 2)" prints as "pi( / 2)") unless they are made active; qf_unicode_lst.tex (generated by facts/make_appA.py) does that.
% (2) \Lthm prints the namespace actually declared in the source (table \lns@<Module> in lean_ns.tex, generated by
%     facts/make_appA.py; 13 of 37 modules are not QuantumFluids.<Module>; unknown modules fall back to QuantumFluids.<Module>),
%     accepts names typed with _ or \_ (a bare _ used to be read as a math subscript), and allows line breaks after . and _.
\InputIfFileExists{qf_unicode_lst}{}{}
\InputIfFileExists{lean_ns}{}{}
\directlua{
  function qf_lthm(s)
    local bs = string.char(92)
    s = string.gsub(s, bs .. "_", "_")
    for _, c in utf8.codes(s) do
      if not (c == 32) then
        tex.sprint(-2, utf8.char(c))
        if c == 95 or c == 46 then tex.sprint(bs .. "allowbreak{}") end
      end
    end
  end
}
% robust: in a moving argument (caption -> list of figures, section title -> contents) it is written out unexpanded and runs
% only when typeset; expanding it at write time put bare underscores into the .lof ("Missing $ inserted").
\DeclareRobustCommand{\Lthm}[2]{\texttt{\ifcsname lns@#1\endcsname\csname lns@#1\endcsname\else QuantumFluids.#1\fi.\allowbreak\directlua{qf_lthm("\luaescapestring{\detokenize{#2}}")}}}
\endinput
