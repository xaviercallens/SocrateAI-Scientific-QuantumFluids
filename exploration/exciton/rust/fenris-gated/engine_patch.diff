+
+/// A radially symmetric pair kernel in the engine's nondimensional units. All three values are those of the
+/// (possibly truncated) potential that is actually used for energy, force and Hessian.
+pub trait Pair: Send + Sync {
+    /// `(U(r), U'(r), U''(r))`, zero beyond the cutoff.
+    fn pair(&self, r: f64) -> (f64, f64, f64);
+    /// Cutoff radius (`f64::INFINITY` if none).
+    fn cutoff(&self) -> f64;
+    /// `U'(r)` used only to set the force scale (untruncated if that differs).
+    fn dv_ref(&self, r: f64) -> f64 {
+        self.pair(r).1
+    }
+    /// `U''(r)` used only to set the time scale.
+    fn d2v_ref(&self, r: f64) -> f64 {
+        self.pair(r).2
+    }
+}
+
+impl Pair for Yukawa {
+    fn pair(&self, r: f64) -> (f64, f64, f64) {
+        Yukawa::pair(self, r)
+    }
+    fn cutoff(&self) -> f64 {
+        self.rc
+    }
+    fn dv_ref(&self, r: f64) -> f64 {
+        self.dv(r)
+    }
+    fn d2v_ref(&self, r: f64) -> f64 {
+        self.d2v(r)
+    }
+}
+
+/// Force on the first point of a pair separated by `d = x_first - x_second`.
+pub fn pair_force(k: &dyn Pair, dx: f64, dy: f64) -> (f64, f64) {
+    let r = (dx * dx + dy * dy).sqrt();
+    if r == 0.0 || r >= k.cutoff() {
+        return (0.0, 0.0);
+    }
+    let dv = k.pair(r).1;
+    (-dv * dx / r, -dv * dy / r)
+}
+
+/// Hessian block `d^2 U(|d|) / dx_first^2` (2 x 2), or `None` outside the cutoff.
+pub fn block(k: &dyn Pair, dx: f64, dy: f64) -> Option<[[f64; 2]; 2]> {
+    let r = (dx * dx + dy * dy).sqrt();
+    if r == 0.0 || r >= k.cutoff() {
+        return None;
+    }
+    let (_, dv, d2v) = k.pair(r);
+    let u = [dx / r, dy / r];
+    let mut m = [[0.0; 2]; 2];
+    for a in 0..2 {
+        for b in 0..2 {
+            let id = if a == b { 1.0 } else { 0.0 };
+            m[a][b] = d2v * u[a] * u[b] + dv / r * (id - u[a] * u[b]);
+        }
+    }
+    Some(m)
+}
